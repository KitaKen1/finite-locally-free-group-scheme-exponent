import Mathlib.Algebra.Ring.GeomSum
import Mathlib.GroupTheory.OrderOfElement
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.NormNum
import Mathlib.Data.Fintype.Pi
import Mathlib.Data.Fin.VecNotation

/-! The rank-nine trace calculation in the commutative algebra generated by a point. -/

open scoped BigOperators

namespace NinePowerCalculation

private def reach (i : Fin 8) : ℕ :=
  ![1, 1743392201, 1, 2615088301, 2789427521, 581130734, 1494336172, 3050936351] i

private theorem reach_spec (i : Fin 8) :
    ((i : ℕ) + 1) * reach i ≡
      (if 3 ∣ (i : ℕ) + 1 then 3 else 1) [MOD 3 ^ 20] := by
  have h : ∀ j : Fin 8, ((j : ℕ) + 1) * reach j ≡
      (if 3 ∣ (j : ℕ) + 1 then 3 else 1) [MOD 3 ^ 20] := by decide
  exact h i

variable {C : Type*} [CommRing C]

private theorem annihilates_pow (c z : C) (h : c * (z - 1) = 0) (k : ℕ) :
    c * (z ^ k - 1) = 0 := by
  rw [← geom_sum_mul, mul_left_comm, h, mul_zero]

private theorem kill_by_multiple (x : C) (order : x ^ (3 ^ 20 : ℕ) = 1)
    (c : C) (i : ℕ) (hi : 0 < i) (hi' : i ≤ 8) (trace : c * (x ^ i - 1) = 0) :
    c * (x ^ (if 3 ∣ i then 3 else 1 : ℕ) - 1) = 0 := by
  let j : Fin 8 := ⟨i - 1, by omega⟩
  have spec := reach_spec j
  have eq : (j : ℕ) + 1 = i := by dsimp [j]; omega
  rw [eq] at spec
  have hp := pow_eq_pow_of_modEq spec order
  rw [pow_mul] at hp
  rw [← hp]
  exact annihilates_pow c (x ^ i) trace (reach j)

private theorem odd_coeff_kills (x : C) (b tr : ℕ → C)
    (newton : ∀ j : ℕ, 0 < j → (j : C) * b j =
      -(∑ i ∈ Finset.range j, b (j - 1 - i) * tr (i + 1)))
    (trace : ∀ i, 0 < i → i ≤ 8 → ¬ 3 ∣ i → tr i * (x - 1) = 0)
    (unit : ∀ j : ℕ, ¬ 3 ∣ j → IsUnit (j : C)) :
    ∀ j, j ≤ 8 → ¬ 3 ∣ j → b j * (x - 1) = 0 := by
  intro j
  induction j using Nat.strong_induction_on with
  | h j ih =>
    intro hj hd
    have hj₀ : 0 < j := Nat.pos_of_ne_zero (fun e => hd (e ▸ dvd_zero 3))
    have eq : (j : C) * (b j * (x - 1)) = 0 := by
      rw [← mul_assoc, newton j hj₀, neg_mul, Finset.sum_mul]
      apply neg_eq_zero.mpr
      refine Finset.sum_eq_zero fun i hi => ?_
      have hi' := Finset.mem_range.mp hi
      by_cases h : 3 ∣ i + 1
      · have k₀ : j - 1 - i < j := by omega
        have k₁ : ¬ 3 ∣ j - 1 - i := fun hh => hd (by
          have e : (j - 1 - i) + (i + 1) = j := by omega
          exact e ▸ Nat.dvd_add hh h)
        rw [mul_right_comm, ih (j - 1 - i) k₀ (by omega) k₁, zero_mul]
      · rw [mul_assoc, trace (i + 1) (by omega) (by omega) h, mul_zero]
    exact (unit j hd).mul_left_cancel (eq.trans (mul_zero _).symm)

private theorem multiple_coeff_kills (h : C) (b tr : ℕ → C)
    (newton : ∀ j : ℕ, 0 < j → (j : C) * b j =
      -(∑ i ∈ Finset.range j, b (j - 1 - i) * tr (i + 1)))
    (trace : ∀ i, 0 < i → i ≤ 8 → tr i * (h - 1) = 0) (j : ℕ)
    (hj₀ : 0 < j) (hj : j ≤ 8) : (j : C) * b j * (h - 1) = 0 := by
  rw [newton j hj₀, neg_mul, Finset.sum_mul]
  apply neg_eq_zero.mpr
  refine Finset.sum_eq_zero fun i hi => ?_
  have hi' := Finset.mem_range.mp hi
  rw [mul_assoc, trace (i + 1) (by omega) (by omega), mul_zero]

/-- In the residue-characteristic-three case, the trace and moment relations force the
27th power of the generating point to be one. -/
theorem pow_twenty_seven (u : Cˣ) (b tr : ℕ → C)
    (ord : (u : C) ^ (3 ^ 20 : ℕ) = 1)
    (newton : ∀ j : ℕ, 0 < j → (j : C) * b j =
      -(∑ i ∈ Finset.range j, b (j - 1 - i) * tr (i + 1)))
    (trace : ∀ i, 0 < i → i ≤ 8 → tr i * ((u : C) ^ i - 1) = 0)
    (unit : ∀ j : ℕ, ¬ 3 ∣ j → IsUnit (j : C))
    (monic : b 0 = 1)
    (mom : ∀ k : ℕ, ∑ j ∈ Finset.range 10, b j * (((u : C) ^ k) ^ (9 - j) - 1) = 0) :
    (u : C) ^ 27 = 1 := by
  let x := (u : C)
  let h := x ^ 3
  have trace₁ (i : ℕ) (hi₀ : 0 < i) (hi : i ≤ 8) (hd : ¬ 3 ∣ i) :
      tr i * (x - 1) = 0 := by
    simpa only [if_neg hd, pow_one] using kill_by_multiple x ord (tr i) i hi₀ hi (trace i hi₀ hi)
  have trace₃ (i : ℕ) (hi₀ : 0 < i) (hi : i ≤ 8) : tr i * (h - 1) = 0 := by
    by_cases hd : 3 ∣ i
    · simpa only [if_pos hd] using kill_by_multiple x ord (tr i) i hi₀ hi (trace i hi₀ hi)
    · exact annihilates_pow (tr i) x (trace₁ i hi₀ hi hd) 3
  have off (k j : ℕ) (hj : j ≤ 8) (hd : ¬ 3 ∣ j) :
      b j * ((x ^ k) ^ (9 - j) - 1) = 0 := by
    rw [← pow_mul]
    exact annihilates_pow (b j) x (odd_coeff_kills x b tr newton trace₁ unit j hj hd) _
  have cub (k : ℕ) :
      (h ^ k) ^ 3 - 1 + b 3 * ((h ^ k) ^ 2 - 1) + b 6 * (h ^ k - 1) = 0 := by
    have e := mom k
    change ∑ j ∈ Finset.range 10, b j * ((x ^ k) ^ (9 - j) - 1) = 0 at e
    have h9 : (x ^ k) ^ (9 : ℕ) = (h ^ k) ^ 3 := by dsimp [h]; simp only [← pow_mul]; congr 1; omega
    have h6 : (x ^ k) ^ (6 : ℕ) = (h ^ k) ^ 2 := by dsimp [h]; simp only [← pow_mul]; congr 1; omega
    have h3 : (x ^ k) ^ (3 : ℕ) = h ^ k := by dsimp [h]; simp only [← pow_mul]; congr 1; omega
    simp only [Finset.sum_range_succ, Finset.sum_range_zero, monic, one_mul, zero_add, add_zero,
      off k 1 (by decide) (by decide), off k 2 (by decide) (by decide),
      off k 4 (by decide) (by decide), off k 5 (by decide) (by decide),
      off k 7 (by decide) (by decide), off k 8 (by decide) (by decide),
      Nat.sub_zero, Nat.sub_self, pow_zero, sub_self, mul_zero] at e
    norm_num at e
    rw [h9, h6, h3] at e
    exact e
  have b3 : 3 * b 3 * (h - 1) = 0 := multiple_coeff_kills h b tr newton trace₃ 3 (by decide) (by decide)
  have b6 : 3 * b 6 * (h - 1) = 0 := by
    have m := multiple_coeff_kills h b tr newton trace₃ 6 (by decide) (by decide)
    have e : (2 : C) * (3 * b 6 * (h - 1)) = 0 := by linear_combination m
    have un : IsUnit (2 : C) := unit 2 (by decide)
    exact un.mul_left_cancel (e.trans (mul_zero _).symm)
  have D3 : 3 * (h ^ 3 - 1) = 0 := by
    have e := cub 1
    simp only [pow_one] at e
    linear_combination 3 * e - (h + 1) * b3 - b6
  have product : (h ^ 3 - 1) * (h ^ 3 - h) * (h ^ 3 - h ^ 2) = 0 := by
    have c1 := cub 1
    simp only [pow_one] at c1
    linear_combination cub 3 - (1 + h + h ^ 2) * cub 2 + (h + h ^ 2 + h ^ 3) * c1
  have hun : IsUnit h := (Units.isUnit u).pow 3
  have D12 : (h ^ 3 - 1) * (h - 1) * (h ^ 2 - 1) = 0 := by
    have e : h ^ 3 * ((h ^ 3 - 1) * (h - 1) * (h ^ 2 - 1)) = 0 := by
      linear_combination product
    exact (hun.pow 3).mul_left_cancel (e.trans (mul_zero _).symm)
  have hord : h ^ (3 ^ 20 : ℕ) = 1 := by
    calc
      h ^ (3 ^ 20 : ℕ) = (x ^ (3 ^ 20 : ℕ)) ^ 3 := by
        change (x ^ 3) ^ (3 ^ 20 : ℕ) = _
        rw [← pow_mul, ← pow_mul, Nat.mul_comm 3 (3 ^ 20)]
      _ = 1 := by
        have ordx : x ^ (3 ^ 20 : ℕ) = 1 := ord
        rw [ordx, one_pow]
  have e : (h ^ 2) ^ 1743392201 = h := by
    rw [← pow_mul]
    exact (pow_eq_pow_of_modEq (by decide : 2 * 1743392201 ≡ 1 [MOD 3 ^ 20]) hord).trans (pow_one _)
  have D11 : (h ^ 3 - 1) * (h - 1) ^ 2 = 0 := by
    rw [pow_two, ← mul_assoc]
    have hf := annihilates_pow _ _ D12 1743392201
    rwa [e] at hf
  have DD : (h ^ 3 - 1) ^ 2 = 0 := by
    linear_combination (h - 1) * D11 + (h ^ 2 - h) * D3
  change x ^ 27 = 1
  have re : x ^ 27 = (h ^ 3) ^ 3 := by dsimp [h]; simp only [← pow_mul]
  rw [re]
  linear_combination (h ^ 3 - 1 + 3) * DD + D3

end NinePowerCalculation
