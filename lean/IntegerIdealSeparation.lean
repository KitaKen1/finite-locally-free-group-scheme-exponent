import Mathlib.RingTheory.Filtration
import Mathlib.RingTheory.Jacobson.Ring
import Mathlib.RingTheory.Ideal.Quotient.HasFiniteQuotients
import Mathlib.RingTheory.Ideal.Quotient.Index
import Mathlib.Algebra.Ring.Int.Field
import Mathlib.Data.Int.Order.Units
import Mathlib.Tactic.Ring

/-!
# Finite countermodels for integer polynomial equations

If an integer polynomial is outside the ideal generated by the equations, a
finite commutative ring already witnesses this. The witness can be nonreduced.
-/

namespace IntegerIdealSeparation

universe u

private theorem int_isJacobson : IsJacobsonRing ℤ := by
  apply isJacobsonRing_iff_prime_eq.mpr
  intro P hP
  by_cases hp : P = ⊥
  · subst P
    apply le_antisymm _ bot_le
    intro x hx
    have hx' : (1 - 3 * x : ℤ) - 1 ∈ (⊥ : Ideal ℤ).jacobson := by
      convert (⊥ : Ideal ℤ).jacobson.mul_mem_left (-3) hx using 1 <;> ring
    have hu := Ideal.isUnit_of_sub_one_mem_jacobson_bot (1 - 3 * x) hx'
    rw [Int.isUnit_iff_abs_eq] at hu
    rw [Submodule.mem_bot]
    by_cases hn : 0 ≤ 1 - 3 * x
    · rw [abs_of_nonneg hn] at hu
      omega
    · rw [abs_of_neg (lt_of_not_ge hn)] at hu
      omega
  · letI : P.IsPrime := hP
    letI : P.IsMaximal := Ring.HasFiniteQuotients.maximalOfPrime hp
    exact Ideal.jacobson_eq_self_of_isMaximal

private theorem intCast_finiteType_iff (B : Type*) [CommRing B] :
    (Int.castRingHom B).FiniteType ↔ Algebra.FiniteType ℤ B := by
  rw [show Int.castRingHom B = algebraMap ℤ B from Subsingleton.elim _ _]
  exact RingHom.finiteType_algebraMap

private theorem finite_field_of_finiteType_int (K : Type*) [Field K]
    (hK : (Int.castRingHom K).FiniteType) : Finite K := by
  letI : IsJacobsonRing ℤ := int_isJacobson
  letI : Algebra.FiniteType ℤ K := (intCast_finiteType_iff K).mp hK
  letI : Module.Finite ℤ K := finite_of_finite_type_of_isJacobsonRing ℤ K
  let P : Ideal ℤ := Ideal.under ℤ (⊥ : Ideal K)
  have hp : P.IsMaximal := Ideal.isMaximal_under_of_isIntegral_of_isMaximal (⊥ : Ideal K)
  have hP : P ≠ ⊥ := Ring.ne_bot_of_isMaximal_of_not_isField hp Int.not_isField
  letI : Finite (ℤ ⧸ P) := Ring.HasFiniteQuotients.finiteQuotient hP
  letI : Module.Finite (ℤ ⧸ P) (K ⧸ (⊥ : Ideal K)) :=
    Module.Finite.of_restrictScalars_finite ℤ _ _
  letI : Finite (K ⧸ (⊥ : Ideal K)) := Module.finite_of_finite (ℤ ⧸ P)
  exact Finite.of_equiv _ (RingEquiv.quotientBot K).toEquiv

private theorem finiteType_int_quotient {B : Type*} [CommRing B]
    (hB : (Int.castRingHom B).FiniteType) (I : Ideal B) :
    (Int.castRingHom (B ⧸ I)).FiniteType := by
  have he : (Ideal.Quotient.mk I).comp (Int.castRingHom B) = Int.castRingHom (B ⧸ I) :=
    Subsingleton.elim _ _
  rw [← he]
  exact (RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective).comp hB

/-- A nonzero element of a finitely generated integer algebra survives in a finite quotient. -/
theorem exists_finite_quotient_separating (B : Type*) [CommRing B]
    (hB : (Int.castRingHom B).FiniteType) (x : B) (hx : x ≠ 0) :
    ∃ I : Ideal B, Finite (B ⧸ I) ∧ x ∉ I := by
  let ann : Ideal B := (LinearMap.toSpanSingleton B B x).ker
  have hproper : ann ≠ ⊤ := by
    intro h
    have h1 : (1 : B) ∈ ann := h ▸ Submodule.mem_top
    exact hx (by simpa [ann, LinearMap.mem_ker] using h1)
  obtain ⟨m, hm, hle⟩ := ann.exists_le_maximal hproper
  letI : m.IsMaximal := hm
  letI : Field (B ⧸ m) := Ideal.Quotient.field m
  letI : Finite (B ⧸ m) := finite_field_of_finiteType_int (B ⧸ m) (finiteType_int_quotient hB m)
  letI : Algebra.FiniteType ℤ B := (intCast_finiteType_iff B).mp hB
  letI : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing ℤ B
  have hn : ∃ k : ℕ, x ∉ m ^ k := by
    by_contra! ha
    have hall : x ∈ (⨅ k : ℕ, m ^ k • ⊤ : Submodule B B) := by
      rw [Submodule.mem_iInf]
      intro k
      simpa only [smul_eq_mul, Ideal.mul_top] using ha k
    obtain ⟨r, hr⟩ := (m.mem_iInf_smul_pow_eq_bot_iff x).mp hall
    have hsub : 1 - (r : B) ∈ ann := by
      change (1 - (r : B)) * x = 0
      rw [sub_mul, one_mul, (show (r : B) * x = x from hr), sub_self]
    have h1 : (1 : B) ∈ m := by simpa using m.add_mem (hle hsub) r.property
    exact hm.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
  obtain ⟨k, hk⟩ := hn
  exact ⟨m ^ k, Ideal.finite_quotient_pow (IsNoetherian.noetherian m) k, hk⟩

private theorem intCast_finiteType_polynomial (σ : Type*) [Finite σ] :
    (Int.castRingHom (MvPolynomial σ ℤ)).FiniteType := by
  apply (intCast_finiteType_iff _).mpr
  let f : MvPolynomial σ ℤ →ₐ[ℤ] MvPolynomial σ ℤ := MvPolynomial.aeval MvPolynomial.X
  have hf : f.toRingHom = RingHom.id _ := by
    ext i <;> simp [f]
  exact Algebra.FiniteType.iff_quotient_mvPolynomial'.mpr
    ⟨σ, Fintype.ofFinite σ, f, fun y => ⟨y, DFunLike.congr_fun hf y⟩⟩

/-- A negative ideal-membership answer admits a finite-ring certificate. -/
theorem not_mem_iff_finite_assignment {σ : Type u} {ι : Type*} [Finite σ]
    (relations : ι → MvPolynomial σ ℤ) (target : MvPolynomial σ ℤ) :
    target ∉ Ideal.span (Set.range relations) ↔
      ∃ (D : Type u) (_ : CommRing D) (_ : Finite D) (a : σ → D),
        (∀ i, MvPolynomial.eval₂Hom (Int.castRingHom D) a (relations i) = 0) ∧
        MvPolynomial.eval₂Hom (Int.castRingHom D) a target ≠ 0 := by
  let I := Ideal.span (Set.range relations)
  constructor
  · intro hn
    let B := MvPolynomial σ ℤ ⧸ I
    have hB : (Int.castRingHom B).FiniteType := finiteType_int_quotient (intCast_finiteType_polynomial σ) I
    let q : MvPolynomial σ ℤ →+* B := Ideal.Quotient.mk I
    have hq : q target ≠ 0 := fun h => hn (Ideal.Quotient.eq_zero_iff_mem.mp h)
    obtain ⟨J, hJ, ht⟩ := exists_finite_quotient_separating B hB (q target) hq
    let D := B ⧸ J
    let f : MvPolynomial σ ℤ →+* D := (Ideal.Quotient.mk J).comp q
    let a (i : σ) := f (MvPolynomial.X i)
    have he : MvPolynomial.eval₂Hom (Int.castRingHom D) a = f := by
      ext i <;> simp [a]
    refine ⟨D, inferInstance, hJ, a, ?_, ?_⟩
    · intro i
      have hi : q (relations i) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)
      rw [he]
      change Ideal.Quotient.mk J (q (relations i)) = 0
      rw [hi, map_zero]
    · rw [he]
      exact fun h => ht (Ideal.Quotient.eq_zero_iff_mem.mp h)
  · rintro ⟨D, _, _, a, equations, nonzero⟩ hi
    let f := MvPolynomial.eval₂Hom (Int.castRingHom D) a
    have hker : I ≤ RingHom.ker f := Ideal.span_le.mpr <| by
      rintro _ ⟨i, rfl⟩
      exact equations i
    exact nonzero (hker hi)

/-- Both outcomes of an integer ideal-membership test have finite certificates. -/
theorem polynomial_certificate_dichotomy {σ : Type u} {ι : Type*} [Finite σ] [Fintype ι]
    (relations : ι → MvPolynomial σ ℤ) (target : MvPolynomial σ ℤ) :
    (∃ multipliers : ι → MvPolynomial σ ℤ, (∑ i, multipliers i * relations i) = target) ∨
      (∃ (D : Type u) (_ : CommRing D) (_ : Finite D) (a : σ → D),
        (∀ i, MvPolynomial.eval₂Hom (Int.castRingHom D) a (relations i) = 0) ∧
        MvPolynomial.eval₂Hom (Int.castRingHom D) a target ≠ 0) := by
  classical
  by_cases h : target ∈ Ideal.span (Set.range relations)
  · exact Or.inl (Ideal.mem_span_range_iff_exists_fun.mp h)
  · exact Or.inr ((not_mem_iff_finite_assignment relations target).mp h)

end IntegerIdealSeparation

#print axioms IntegerIdealSeparation.exists_finite_quotient_separating
#print axioms IntegerIdealSeparation.not_mem_iff_finite_assignment
#print axioms IntegerIdealSeparation.polynomial_certificate_dichotomy
